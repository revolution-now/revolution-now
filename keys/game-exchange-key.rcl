# Seed with which to seed the random number generator just before
# gameplay begins. Can be null, in which case a random device
# will be used for the seeding.
gameplay_seed: X6d8207fbe419be2446239a50771ea417

map.source.generate_native.setup {
  size { w: 56, h: 70 }

  surface_generator {
    perlin_settings {
      edge_suppression {
        enabled: true
        strength: { w: 0.90, h: 0.77 }
      }
      land_form {
        fractal {
          lacunarity: 2
          n_octaves: 5
          persistence: 0.5
        }
        scale: 12
      }
      elevation {
        enabled: true
        hills_divisor:      4.00
        mountains_divisor: 15.00
      }
      mountains {
        enabled: true
        density_divisor: 8.0
      }
      seed {
        base: 1152681597
        offset_x: 876454408
        offset_y: 2451924743
        flip: false
      }
    }
    lakes {
      seed: Xf4ff514737de39e717b047f54068b0a5
      # Ranges from [-1, 1] with 0.0 => OG.
      bias: 0.0
    }
    arctic {
      seed: Xae5312d3978ed9ef0bedf14820419370
      enabled: true
      density.fraction: 0.6
    }
    clear_corridor {
      location:   north
      rows.value: 2
      suppress_on_path_found: true
    }
    sanitization {
      remove_crosses: true
      remove_islands: true
    }
    target_density.fraction: 0.23
  }

  weather {
    temperature.value:  0
    climate.value:      0
  }

  # NOTE: the river parameters normally vary by the chosen cli-
  # mate and land form scale, so if you vary those you may want
  # to vary these as well (see the map-gen config).
  rivers {
    seed: Xac0304879ebe1280b0f9ca5e56f762fc
    parameters {
      min_length:                4
      growth.probability:        .60
      initiation.probability:    .052
      start_major.probability:   .25
      sustain_major.probability: .57
      turn.probability:          .32
      fork.probability:          .116
      fork_is_major.probability: .47
    }
  }

  biomes {
    seed: X48d55a01aef7295a21b2aabd78d68347
  }

  bonuses.seed: Xde7db42af1959c181457f2eb81adaf6c
}

nations.nations {
  dutch {
    control: ai
    name: Michiel De Ruyter
  }
  english {
    control: human
    name: Walter Raleigh
  }
  french {
    control: ai
    name: Jacques Cartier
  }
  spanish {
    control: ai
    name: Christopher Columbus
  }
}

natives.tribes {
  apache {}
  arawak {}
  aztec {}
  cherokee {}
  inca {}
  iroquois {}
  sioux {}
  tupi {}
}

settings {
  difficulty: conquistador
  rules {
    deadline_for_winning: 1850
    enable_war_of_succession: true
    ref_can_spawn_ships: true
    wagon_train_limit_mode: classic
    withdraw_on_declaration: true
  }
  starting_year: 1492
}