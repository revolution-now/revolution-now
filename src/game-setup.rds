# config
include "config/map-gen-enums.rds.hpp"

# ss
include "ss/difficulty.rds.hpp"
include "ss/key.rds.hpp"
include "ss/nation.rds.hpp"

# rand
include "rand/perlin.rds.hpp"

# C++ standard library
include "<string>"

namespace "rn"

struct.ClassicGameSetupParamsCommon {
  difficulty 'e_difficulty',
  player 'e_nation',
  player_name 'std::string',
}

struct.ClassicGameSetupParamsCustom {
  land_mass 'e_land_mass',
  land_form 'e_land_form',
  temperature 'e_temperature',
  climate 'e_climate',
}

struct.ClassicGameSetupParams {
  common 'ClassicGameSetupParamsCommon',
  custom 'ClassicGameSetupParamsCustom ',
}

struct.ClassicGameSetupParamsEvaluated {
  # These are the minimum that the user must provide when cre-
  # ating any new game (difficulty, nation, leader name).
  common 'ClassicGameSetupParamsCommon',
  # These four correspond to the four settings that the OG
  # presents when customizing a game (land mass, land form, tem-
  # perature, climate). See comments above definition of Weather-
  # Value for what values these can take on and their meanings.
  land_density 'double',
  land_form 'rng::PerlinLandForm',
  temperature 'WeatherValue',
  climate     'WeatherValue',
  _features { equality, validation }
}

enum.e_customization_mode {
  classic,
  modern,
  extreme,
}
