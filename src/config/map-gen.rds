#
# Description: Config data for the map-gen module.
#
# ===============================================================
# config
include "map-gen-enums.rds.hpp"

# ss
include "ss/terrain-enums.rds.hpp"
include "ss/rds-helpers.hpp"
include "ss/key.rds.hpp"

# gfx
include "gfx/cartesian.hpp"

# refl
include "refl/enum-map.hpp"

namespace "rn.config.map_gen"

struct.LandMass {
  fully_random 'std::vector<e_land_mass>',
  customized 'refl::enum_map<e_land_mass, BoundedNormalDist>',
  _features { equality, validation }
}

struct.Arctic {
  enabled 'bool',
  min_map_height 'int',
  density 'DoublePercent',
}

struct.InlandLakes {
  bias 'UniformDist',
  _features { equality, validation }
}

struct.PerlinLandFormRange {
  scale 'BoundedNormalDist',
  fractal 'rng::PerlinFractalOptions',
  _features { equality, validation }
}

struct.LandForm {
  fully_random 'std::vector<e_land_form>',
  customized 'refl::enum_map<e_land_form, PerlinLandFormRange>',
  perlin_edge_suppression 'PerlinEdgeSuppression',
  _features { equality, validation }
}

struct.LandLayout {
  land_mass 'LandMass',
  land_form 'LandForm',
  inland_lakes 'InlandLakes',
  arctic 'Arctic',

  remove_crosses 'bool',
}

struct.Temperature {
  fully_random 'std::vector<e_temperature>',
  customized 'refl::enum_map<e_temperature, WeatherValue>',
  _features { equality, validation }
}

struct.Climate {
  fully_random 'std::vector<e_climate>',
  customized 'refl::enum_map<e_climate, WeatherValue>',
  _features { equality, validation }
}

struct.Weather {
  temperature 'Temperature',
  climate 'Climate',
}

struct.BiomeCurveParams {
  weight 'double',
  center 'double',
  stddev 'double',
  sub    'double',
}

struct.BiomeCurve {
  exp    'int',
  params 'BiomeCurveParams',
  _features { equality, validation }
}

struct.BiomeDensities {
  normal_temperature_and_climate [[
    refl::enum_map<e_biome, BiomeCurve>
  ]],
  temperature_gradient [[
    refl::enum_map<e_biome, BiomeCurveParams>
  ]],
  climate_gradient [[
    refl::enum_map<e_biome, BiomeCurveParams>
  ]],
}

struct.Biomes {
  densities 'BiomeDensities',
}

struct.Formations {
  formation 'refl::enum_map<e_terrain_formation, Formation>',
}

struct.RiverClimateParameters {
  # This length includes the water tile which initiates the
  # river.
  initiation 'Probability',
  start_major 'Probability',
  sustain_major 'Probability',
  turn 'Probability',
  fork 'Probability',
  fork_is_major 'Probability',
}

struct.RiverLandFormParameters {
  growth 'Probability',
}

struct.Rivers {
  min_length 'int',
  for_land_form 'refl::enum_map<e_land_form, RiverLandFormParameters>',
  for_climate 'refl::enum_map<e_climate, RiverClimateParameters>',
  _features { equality, validation }
}

struct.TerrainGeneration {
  land_layout 'LandLayout',
  wetness 'WetnessConfig',
  weather 'Weather',
  rivers 'Rivers',
  biomes 'Biomes',
  formations 'Formations',
}

struct.DwellingGeneration {
  # TODO
}

namespace "rn"

struct.config_map_gen_t {
  default_map_size 'gfx::size',
  terrain_generation 'config::map_gen::TerrainGeneration',
  dwelling_generation 'config::map_gen::DwellingGeneration',

  _features { equality, validation }
}

config.map_gen {}
