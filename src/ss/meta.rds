# ss
include "key.rds.hpp"

# rand
include "rand/entropy.hpp"

# base
include "base/maybe.hpp"

# C++ standard library
include "<string>"

namespace "rn"

struct.Seeds {
  gameplay_seed 'base::maybe<rng::seed>',
}

sumtype.CreationStrategy {
  unspecified {},
  manual {
    description 'std::string',
  },
  exchange_key {
    value 'ExchangeKey',
  },
}

struct.MetaState {
  seeds 'Seeds',
  creation_strategy 'CreationStrategy',
}
