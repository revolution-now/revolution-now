# ss
include "key.rds.hpp"

# rand
include "rand/entropy.hpp"

# base
include "base/maybe.hpp"

# C++ standard library
include "<string>"

namespace "rn"

struct.Seeds {
  gameplay_seed 'base::maybe<rng::seed>',
}

sumtype.ExchangeKeyGenerationMethod {
  user_generated {},
  new_game {},
  america {},
  map_gen {},
  customize_game {
  },
}

sumtype.CreationStrategy {
  # The game was created via an exchange key either generated by
  # the game or manually provided.
  exchange_key {
    key 'ExchangeKey',
    generation_method 'ExchangeKeyGenerationMethod',
  },

  # Some non-standard way was used to create the game.
  other {
    description 'base::maybe<std::string>',
  },
}

struct.MetaState {
  seeds 'Seeds',
  creation_strategy 'CreationStrategy',
}
