# base
include "base/maybe.hpp"

namespace "rn"

enum.e_wagon_train_limit_mode {
  classic,
  population,
  none,
}

struct.GameRulesOptions {
  enable_war_of_succession 'bool',
  ref_can_spawn_ships 'bool',
  withdraw_on_declaration 'bool',
  deadline_for_winning 'base::maybe<int>',
  wagon_train_limit_mode 'e_wagon_train_limit_mode',
  # NOTE: if you add a new one here be sure to add a corre-
  # sponding field in config/options.
  _features { equality, validation }
}
